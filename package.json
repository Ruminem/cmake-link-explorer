{
  "name": "cmake-link-explorer",
  "displayName": "CMake Link Explorer",
  "description": "Browse CMake target link structure in both directions: what a target links, and what links it.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:objective-cpp",
    "workspaceContains:**/CMakeLists.txt"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cmakeLinkExplorer",
          "title": "CMake Links",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cmakeLinkExplorer": [
        {
          "id": "cmakeLinkExplorer.targets",
          "name": "Targets",
          "icon": "media/icon.svg"
        },
        {
          "id": "cmakeLinkExplorer.map",
          "name": "Linker Map",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cmakeLinkExplorer.targets",
        "contents": "No CMake build directory loaded yet.\n\nPick the build directory that contains CMakeCache.txt.\n[Select build directory](command:cmakeLinkExplorer.selectBuildDir)\n\nIf the build directory is already selected but empty, CMake needs to regenerate once so it can emit the File API reply.\n[Run CMake configure](command:cmakeLinkExplorer.configure)"
      },
      {
        "view": "cmakeLinkExplorer.map",
        "contents": "No linker map loaded.\n\nBuild with a map file first, for example `-Wl,-Map=out.map` (GNU ld) or `-Wl,-map,out.map` (Apple ld64).\n[Open map file](command:cmakeLinkExplorer.openMap)\n\nTo see what changed between two builds:\n[Compare two map files](command:cmakeLinkExplorer.diffMaps)"
      }
    ],
    "commands": [
      {
        "command": "cmakeLinkExplorer.refresh",
        "title": "Refresh",
        "category": "CMake Links",
        "icon": "$(refresh)"
      },
      {
        "command": "cmakeLinkExplorer.selectBuildDir",
        "title": "Select Build Directory",
        "category": "CMake Links",
        "icon": "$(folder-opened)"
      },
      {
        "command": "cmakeLinkExplorer.search",
        "title": "Find Target",
        "category": "CMake Links",
        "icon": "$(search)"
      },
      {
        "command": "cmakeLinkExplorer.whyLinked",
        "title": "Why Is This Linked? (trace path between two targets)",
        "category": "CMake Links"
      },
      {
        "command": "cmakeLinkExplorer.configure",
        "title": "Run CMake Configure",
        "category": "CMake Links"
      },
      {
        "command": "cmakeLinkExplorer.openCMakeLists",
        "title": "Open CMakeLists.txt",
        "category": "CMake Links",
        "icon": "$(go-to-file)"
      },
      {
        "command": "cmakeLinkExplorer.copyName",
        "title": "Copy Target Name",
        "category": "CMake Links"
      },
      {
        "command": "cmakeLinkExplorer.openMap",
        "title": "Open Map File",
        "category": "CMake Links",
        "icon": "$(file-binary)"
      },
      {
        "command": "cmakeLinkExplorer.diffMaps",
        "title": "Compare Two Map Files",
        "category": "CMake Links",
        "icon": "$(git-compare)"
      },
      {
        "command": "cmakeLinkExplorer.closeMap",
        "title": "Close Map",
        "category": "CMake Links",
        "icon": "$(close)"
      },
      {
        "command": "cmakeLinkExplorer.linkForInclude",
        "title": "Which Library Provides This Include?",
        "category": "CMake Links",
        "icon": "$(library)"
      },
      {
        "command": "cmakeLinkExplorer.applyLinkForInclude",
        "title": "Link The Library For This Include",
        "category": "CMake Links"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cmakeLinkExplorer.search",
          "when": "view == cmakeLinkExplorer.targets",
          "group": "navigation@1"
        },
        {
          "command": "cmakeLinkExplorer.refresh",
          "when": "view == cmakeLinkExplorer.targets",
          "group": "navigation@2"
        },
        {
          "command": "cmakeLinkExplorer.selectBuildDir",
          "when": "view == cmakeLinkExplorer.targets",
          "group": "navigation@3"
        },
        {
          "command": "cmakeLinkExplorer.whyLinked",
          "when": "view == cmakeLinkExplorer.targets",
          "group": "1_actions"
        },
        {
          "command": "cmakeLinkExplorer.configure",
          "when": "view == cmakeLinkExplorer.targets",
          "group": "1_actions"
        },
        {
          "command": "cmakeLinkExplorer.openMap",
          "when": "view == cmakeLinkExplorer.map",
          "group": "navigation@1"
        },
        {
          "command": "cmakeLinkExplorer.diffMaps",
          "when": "view == cmakeLinkExplorer.map",
          "group": "navigation@2"
        },
        {
          "command": "cmakeLinkExplorer.closeMap",
          "when": "view == cmakeLinkExplorer.map",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "cmakeLinkExplorer.openCMakeLists",
          "when": "view == cmakeLinkExplorer.targets && viewItem =~ /^target/",
          "group": "inline"
        },
        {
          "command": "cmakeLinkExplorer.copyName",
          "when": "view == cmakeLinkExplorer.targets && viewItem =~ /^target/",
          "group": "1_copy"
        }
      ],
      "editor/context": [
        {
          "command": "cmakeLinkExplorer.linkForInclude",
          "when": "editorLangId == cpp || editorLangId == c",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "cmakeLinkExplorer.applyLinkForInclude",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "CMake Link Explorer",
      "properties": {
        "cmakeLinkExplorer.buildDirectory": {
          "type": "string",
          "default": "",
          "description": "Path to the CMake build directory (the one containing CMakeCache.txt). Leave empty to auto-detect."
        },
        "cmakeLinkExplorer.configuration": {
          "type": "string",
          "default": "",
          "description": "Which CMake configuration to show for multi-config generators (e.g. Debug, Release). Empty uses the first one."
        },
        "cmakeLinkExplorer.showUtilityTargets": {
          "type": "boolean",
          "default": false,
          "description": "Show UTILITY targets (custom targets, ALL_BUILD, ZERO_CHECK). Off by default because they are noise for link structure."
        },
        "cmakeLinkExplorer.showExternalLibraries": {
          "type": "boolean",
          "default": true,
          "description": "Show libraries that come from outside the project (system libs, frameworks, prebuilt .a/.so)."
        },
        "cmakeLinkExplorer.showTransitiveDependencies": {
          "type": "boolean",
          "default": false,
          "description": "Show every dependency CMake reports, including ones pulled in transitively. Off by default: the reduced graph matches what target_link_libraries actually declares."
        },
        "cmakeLinkExplorer.demangleSymbols": {
          "type": "boolean",
          "default": true,
          "description": "Run map-file symbol names through a demangler so C++ symbols are readable. Silently skipped if the tool is not installed."
        },
        "cmakeLinkExplorer.demanglerCommand": {
          "type": "string",
          "default": "c++filt",
          "description": "Demangler to use. Set it to your toolchain's, e.g. arm-none-eabi-c++filt."
        },
        "cmakeLinkExplorer.mapSymbolLimit": {
          "type": "number",
          "default": 200,
          "description": "How many of the largest symbols to list from a map file."
        },
        "cmakeLinkExplorer.sortTargets": {
          "type": "string",
          "enum": [
            "structure",
            "size",
            "name"
          ],
          "default": "structure",
          "enumDescriptions": [
            "Executables first, then libraries ordered by how many targets depend on them.",
            "Largest contribution to the linked image first. Needs a linker map to be open.",
            "Plain alphabetical order."
          ],
          "description": "How the target list is ordered. 'structure' surfaces what the project produces and what everything leans on; 'size' needs an open linker map and finds the heavy targets; 'name' is a flat alphabetical list."
        }
      }
    }
  }
}
