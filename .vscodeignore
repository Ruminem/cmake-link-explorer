.vscode/**
test/**
**/*.map

# Development-time only; nothing in the installed extension reads these.
.gitignore
.vscodeignore
jsconfig.json

# Notes for working on this repository, not for people installing it.
CLAUDE.md
NEXT.md

# install.cmd wraps the VSIX for the release zip; inside the VSIX it would be
# a script that installs the thing it is already inside. The zip and the VSIX
# itself are release artifacts that land in this directory when packaging
# locally; without these lines a stale one gets packed into the next VSIX.
install.cmd
*.vsix
*-windows.zip
.github/**
.gitattributes

# The readmes reference the diagrams by absolute URL so they draw the same on
# GitHub, the Marketplace and inside VS Code. Shipping them in the VSIX would
# only make it bigger; nothing reads them from disk.
media/diagrams/**
